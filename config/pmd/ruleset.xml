<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="saucedemo"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>PMD's quickstart rules, with one change for test method names.</description>

    <rule ref="rulesets/java/quickstart.xml">
        <exclude name="MethodNamingConventions"/>
    </rule>

    <!--
      Test methods are named action_expectedOutcome, for example
      clickCheckout_navigatesToCheckoutStepOne. The underscore separates what
      the test does from what it expects, which reads better in reports than
      one long camelCase name. junit5TestPattern only applies to methods
      annotated with @Test (and the other JUnit 5 test annotations), so every
      other method, in tests and in main code, still has to be camelCase.
    -->
    <rule ref="category/java/codestyle.xml/MethodNamingConventions">
        <properties>
            <property name="junit5TestPattern" value="[a-z][a-zA-Z0-9]*(_[a-z][a-zA-Z0-9]*)?"/>
        </properties>
    </rule>
</ruleset>
